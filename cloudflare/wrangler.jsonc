{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "autonomous-qa-runner",
  "main": "index.ts",
  "compatibility_date": "2026-10-02",
  "observability": { "enabled": true },
  "vars": {
    "LLM_PROVIDER": "openrouter",
    "LLM_BASE_URL": "https://openrouter.ai/api/v1",
    "LLM_MODEL": "openrouter/free",
    "MAILTM_ENABLED": "true",
    "QA_MAX_DEPTH": "3",
    "HEADLESS": "true",
    "QA_VISUAL_DIFF": "true",
    "QA_LOG_LEVEL": "INFO"
  },
  "containers": [{
    "class_name": "QARunnerContainer",
    "image": "./Dockerfile",
    "max_instances": 2
  }],
  "durable_objects": {
    "bindings": [{ "name": "QA_RUNNER", "class_name": "QARunnerContainer" }]
  },
  "migrations": [{
    "new_sqlite_classes": ["QARunnerContainer"],
    "tag": "v1"
  }]
}
