# LLM
OPENAI_API_KEY=
OPENAI_BASE_URL=
QA_MODEL=gpt-4o-mini

# Runner
QA_REPORTS_DIR=reports
QA_MAX_DEPTH=3
QA_LOG_LEVEL=INFO
HEADLESS=true
QA_VISUAL_DIFF=false

# Disposable test email
MAILTM_ENABLED=true

# Server
HOST=0.0.0.0
PORT=8000

# .pen visual comparison
PEN_CLI=openpencil
PEN_EXPORT_SCALE=1
PEN_VISUAL_PASS=0.90
