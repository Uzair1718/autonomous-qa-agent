# LLM provider: openrouter, ollama, lmstudio, vllm, or openai-compatible
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openrouter/free

# Runner
QA_REPORTS_DIR=reports
QA_MAX_DEPTH=3
QA_LOG_LEVEL=INFO
HEADLESS=true
QA_VISUAL_DIFF=false

# Disposable test email
MAILTM_ENABLED=true

# Server
HOST=0.0.0.0
PORT=8000

# .pen visual comparison
PEN_CLI=openpencil
PEN_EXPORT_SCALE=1
PEN_VISUAL_PASS=0.90
